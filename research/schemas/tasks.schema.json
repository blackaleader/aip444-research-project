{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-visible task document",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_prompt", "context_budget", "agent_call_limit"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "task_prompt": {"type": "string", "minLength": 1},
          "context_budget": {"type": "integer", "minimum": 1},
          "agent_call_limit": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
