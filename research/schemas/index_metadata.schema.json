{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.research/schemas/index_metadata.schema.json",
  "title": "IndexMetadata",
  "description": "Provenance for an independent Stage 5 NumPy index build. Methods A and B must share the same index for a paired trial on a given snapshot.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "snapshot_sha",
    "embedding_model",
    "dimensions",
    "tokenizer",
    "chunking",
    "index_build_id",
    "chunk_count",
    "built_at",
    "chunker_version"
  ],
  "properties": {
    "snapshot_sha": { "type": "string", "minLength": 1 },
    "embedding_model": { "type": "string", "minLength": 1 },
    "dimensions": { "type": "integer", "minimum": 1 },
    "tokenizer": { "type": "string", "minLength": 1 },
    "chunking": {
      "type": "object",
      "description": "Fingerprint of chunk strategy/size/overlap used for this build."
    },
    "index_build_id": { "type": "string", "minLength": 1 },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "built_at": {
      "type": "string",
      "description": "ISO-8601 build timestamp."
    },
    "chunker_version": { "type": "string", "minLength": 1 }
  }
}
