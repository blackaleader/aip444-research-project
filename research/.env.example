# Copy to .env and fill in local values. Never commit real credentials.
# Never log or print secret values.

# Absolute path to a local clone of https://github.com/earendil-works/pi
# Stage 2 preferred location (outside the group research folder):
#   PI_REPO_PATH=C:\Users\froze\Desktop\pi-upstream
PI_REPO_PATH=

# -----------------------------------------------------------------------------
# OpenRouter (Stage 5 embeddings + Stage 6 chat)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Stage 5 — embeddings only
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Stage 6 — reserved chat models (do not use in Stage 5)
# Primary agent model for claimable Method B results:
OPENROUTER_PRIMARY_CHAT_MODEL=openai/gpt-6-luna
# Optional exploratory secondary; never auto-replace primary; record served model:
OPENROUTER_SECONDARY_CHAT_MODEL=openrouter/free

# Legacy aliases (optional). Prefer OPENROUTER_* above.
# If LLM_BASE_URL points at OpenRouter, LLM_API_KEY may be used as a fallback
# for OPENROUTER_API_KEY by the embedding client.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
